<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para account.payment.method.line -->
    <record id="view_account_journal_form_inherit_sv" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.sv</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='payment_account_id']" position="before">
                <field name="formasDePagos"/>
            </xpath>
            <xpath expr="//field[@name='outbound_payment_method_line_ids']/list/field[@name='payment_account_id']" position="before">
                <field name="formasDePagos"/>
            </xpath>
        </field>
    </record>
</odoo>